{
  "name": "agentpay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @agentpay/server\" \"npm run dev -w @agentpay/web\"",
    "build": "npm run build -w @agentpay/web && npm run build -w @agentpay/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "bash scripts/smoke.sh",
    "check:scaffold": "node scripts/check-scaffold.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.7.3"
  }
}
