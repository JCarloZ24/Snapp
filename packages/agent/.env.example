# Inherit variables from separate private role-specific shells. Never auto-loaded.
# Never use production keys, command arguments, chat, screenshots or shared logs for secrets.
NOIR_OWNER_SECRET=
NOIR_AGENT_SECRET=
NOIR_MERCHANT_SECRET=
ALLOWED_MERCHANT_ADDRESSES=
# Operator attestation only after independent organizer/deployment verification of the documented discrepancy.
NOIR_TESTNET_CONTRACTS_CONFIRMED=false
# Payout Risk & Review Agent (Jev via Vercel AI SDK). Agent shell only. No key => every autopilot verdict DEFERs.
# Direct TypeSafe key (preferred, pins jev-1.14.0): https://console.typesafe.ai/keys (sign-ups currently waitlisted)
TYPESAFE_AI_API_KEY=
# Fallback: Vercel AI Gateway key (model typesafe-ai/jev); Vercel requires a card on file before it serves requests.
# https://vercel.com/docs/ai-gateway/getting-started
AI_GATEWAY_API_KEY=
# Emergency stop: true makes autopilot DEFER every evaluation without touching the journal.
SNAPP_AUTOPILOT_DISABLED=false
