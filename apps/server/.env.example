PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
DEMO_MODE=true
# Real Testnet flow only (never commit values, never put in VITE_ variables)
ADMIN_API_TOKEN=
VELO_API_KEY=
VELO_WEBHOOK_SECRET=
# Owner registers device and policy via Noir extension; server holds AGENT secret only.
NOIR_DEVICE_HASH=
NOIR_AGENT_PUBLIC_KEY=
NOIR_AGENT_SECRET=
# Verified recipient addresses must also be approved in the app/database.
# Use one public Velo webhook endpoint: https://YOUR-SERVER/api/webhooks/velo

# Comma-separated public wallet addresses preapproved for milestone payout
ALLOWED_MERCHANT_ADDRESSES=
